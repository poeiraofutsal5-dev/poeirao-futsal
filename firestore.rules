rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /sponsors/{sponsorId} {
      allow read, write: if true;
    }

    match /members/{memberId} {
      allow read, write: if true;
    }
  }
}
